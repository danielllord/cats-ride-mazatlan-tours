{
  "version": 1,
  "sdk_version": "3.0.1",
  "path": "/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "cats-ride-mazatlan",
      "version": "1.0.0",
      "title": "Cat's Ride Mazatlan"
    },
    "tools": [
      {
        "name": "get_tour_info",
        "title": "Get tour information",
        "description": "Get details about Cat's Ride Mazatlan private tours: what's included, popular stops, drinks, group capacity, policies, and how to contact Martin.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string"
            },
            "capacity": {
              "type": "string"
            },
            "popularStops": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "drinks": {
              "type": "string"
            },
            "policies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "contact": {
              "type": "object",
              "properties": {
                "phone": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "facebook": {
                  "type": "string"
                }
              },
              "required": [
                "phone",
                "email",
                "facebook"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "summary",
            "capacity",
            "popularStops",
            "drinks",
            "policies",
            "contact"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        }
      },
      {
        "name": "submit_tour_inquiry",
        "title": "Submit a tour inquiry",
        "description": "Send a tour inquiry to Martin at Cat's Ride Mazatlan. He replies with tour information and a quote. No payment or deposit is taken. All fields except shipName and questions are required.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100,
              "description": "Customer full name"
            },
            "email": {
              "type": "string",
              "format": "email",
              "maxLength": 255,
              "description": "Customer email — used as the reply-to address"
            },
            "phone": {
              "type": "string",
              "minLength": 7,
              "maxLength": 40,
              "description": "Customer phone number"
            },
            "requestedDate": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Requested tour date, YYYY-MM-DD"
            },
            "partySize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40,
              "description": "Number of people in the party"
            },
            "shipName": {
              "type": "string",
              "maxLength": 120,
              "description": "Cruise ship name, if applicable"
            },
            "questions": {
              "type": "string",
              "maxLength": 2000,
              "description": "Questions or special requests"
            }
          },
          "required": [
            "name",
            "email",
            "phone",
            "requestedDate",
            "partySize"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
